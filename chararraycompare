import java.util.Scanner;

public class CharArrayCompare {

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        // Input
        System.out.print("Enter a string: ");
        String text = sc.next();

        // User-defined method
        char[] arr1 = getCharacters(text);

        // Built-in method
        char[] arr2 = text.toCharArray();

        // Compare arrays
        boolean result = compareArrays(arr1, arr2);

        // Output
        System.out.print("User-defined array: ");
        printArray(arr1);

        System.out.print("Built-in array: ");
        printArray(arr2);

        System.out.println("Are both arrays equal? " + result);

        sc.close();
    }

    // Method to get characters without using toCharArray()
    static char[] getCharacters(String str) {
        char[] result = new char[str.length()];

        for (int i = 0; i < str.length(); i++) {
            result[i] = str.charAt(i);
        }

        return result;
    }

    // Method to compare two char arrays
    static boolean compareArrays(char[] a, char[] b) {
        if (a.length != b.length) {
            return false;
        }

        for (int i = 0; i < a.length; i++) {
            if (a[i] != b[i]) {
                return false;
            }
        }

        return true;
    }

    // Method to print array
    static void printArray(char[] arr) {
        for (char c : arr) {
            System.out.print(c + " ");
        }
        System.out.println();
    }
}
