import java.util.Scanner;

public class SplitCompare {

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        // Input
        System.out.print("Enter a sentence: ");
        String text = sc.nextLine();

        // User-defined split
        String[] arr1 = splitText(text);

        // Built-in split
        String[] arr2 = text.split(" ");

        // Compare arrays
        boolean result = compareArrays(arr1, arr2);

        // Output
        System.out.println("User-defined split:");
        printArray(arr1);

        System.out.println("Built-in split:");
        printArray(arr2);

        System.out.println("Are both results equal? " + result);

        sc.close();
    }

    // Method to find length without using length()
    static int findLength(String str) {
        int count = 0;
        try {
            while (true) {
                str.charAt(count);
                count++;
            }
        } catch (StringIndexOutOfBoundsException e) {
            // end reached
        }
        return count;
    }

    // Method to split text without using split()
    static String[] splitText(String str) {

        int len = findLength(str);

        // Count words (spaces + 1)
        int words = 1;
        for (int i = 0; i < len; i++) {
            if (str.charAt(i) == ' ') {
                words++;
            }
        }

        // Store space indexes
        int[] spaceIndex = new int[words - 1];
        int k = 0;

        for (int i = 0; i < len; i++) {
            if (str.charAt(i) == ' ') {
                spaceIndex[k++] = i;
            }
        }

        // Extract words
        String[] result = new String[words];
        int start = 0;

        for (int i = 0; i < words - 1; i++) {
            int end = spaceIndex[i];
            result[i] = extractWord(str, start, end);
            start = end + 1;
        }

        // Last word
        result[words - 1] = extractWord(str, start, len);

        return result;
    }

    // Extract substring using charAt()
    static String extractWord(String str, int start, int end) {
        String word = "";
        for (int i = start; i < end; i++) {
            word += str.charAt(i);
        }
        return word;
    }

    // Compare two string arrays
    static boolean compareArrays(String[] a, String[] b) {
        if (a.length != b.length) {
            return false;
        }

        for (int i = 0; i < a.length; i++) {
            if (!compareStrings(a[i], b[i])) {
                return false;
            }
        }

        return true;
    }

    // Compare two strings using charAt()
    static boolean compareStrings(String s1, String s2) {
        if (findLength(s1) != findLength(s2)) {
            return false;
        }

        for (int i = 0; i < findLength(s1); i++) {
            if (s1.charAt(i) != s2.charAt(i)) {
                return false;
            }
        }

        return true;
    }

    // Print array
    static void printArray(String[] arr) {
        for (String word : arr) {
            System.out.print(word + " | ");
        }
        System.out.println();
    }
}
